# NEVER commit your .env.local file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000

# Production (your Render backend URL):
# NEXT_PUBLIC_API_URL=https://vedaai-backend.onrender.com
