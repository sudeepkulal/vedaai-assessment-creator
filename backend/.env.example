# ─────────────────────────────────────────────────────────────────────────────
# VedaAI Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# NODE_ENV: 'development' | 'production'
NODE_ENV=development

# ── MongoDB (MongoDB Atlas connection string for production) ──────────────────
# Local:      mongodb://localhost:27017/vedaai
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vedaai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/vedaai

# ── Redis (Upstash for production, local Docker for development) ──────────────
# Local Docker:
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=   # leave blank for local Docker
# REDIS_PASSWORD=   # leave blank for local Docker
# REDIS_TLS=false   # set to true for Upstash or any TLS-enabled Redis

# Upstash example (uncomment and fill in for production):
# REDIS_HOST=<your-endpoint>.upstash.io
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=<your-upstash-password>
# REDIS_TLS=true

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example for production: https://vedaai.vercel.app,https://www.vedaai.com
ALLOWED_ORIGINS=http://localhost:3000
